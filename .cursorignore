###############################################################################
# 9. Tool-specific junk (customize as you notice patterns)
###############################################################################

# Test artifacts
test-output/
test-output-*/
tests/output/
tests/tmp/

# Local scripts scratch
scratch/
sandbox/
.local-only/
local/